rules_version = '2';

// B1 placeholder: deny every client read and write. B2 replaces this with the rules from
// CONTRACT §3 (Writer column, §3.6 status transitions) and ARCHITECTURE §3.3, with tests.
// Functions and scripts use the Admin SDK and are not affected.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
