{
  "name": "fridgelist-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "npm run fixtures && tsc -p tsconfig.build.json && node scripts/copy-prompts.mjs",
    "typecheck": "npm run fixtures && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test:unit && npm run test:emulator",
    "test:unit": "npm run fixtures && vitest run",
    "test:emulator": "firebase emulators:exec --config ../firebase.rules-test.json --only firestore --project demo-fridgelist-rules \"vitest run -c vitest.emulator.config.ts\"",
    "fixtures": "node scripts/copy-fixtures.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@google-cloud/speech": "8.2.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "geofire-common": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "firebase": "13.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
