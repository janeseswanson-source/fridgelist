<?xml version="1.0" encoding="utf-8"?>
<!-- dev flavor only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Simulates FCM pushes (CONTRACT §5) on the emulator, where the demo project gets no real
          pushes. Guarded by DUMP, which only the adb shell holds:
          adb shell am broadcast -a com.fridgelist.app.debug.PUSH -n <pkg>/com.fridgelist.app.debug.DebugPushReceiver             -\-es type trip_heading -\-es householdId h1 ...
        -->
        <receiver
            android:name="com.fridgelist.app.debug.DebugPushReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.fridgelist.app.debug.PUSH" />
            </intent-filter>
        </receiver>
        <!-- Hosts the list widget at every size for screenshots (A8); see WidgetPreviewActivity. -->
        <activity
            android:name="com.fridgelist.app.debug.WidgetPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.FridgeList" />
    </application>
</manifest>
