<?xml version="1.0" encoding="utf-8"?>
<!--
  No cloud backup and no device-to-device copy: the data lives in Firestore, and the per-install
  deviceId (CONTRACT §3.2) must never be cloned onto a second phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
